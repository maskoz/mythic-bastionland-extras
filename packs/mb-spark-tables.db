":{}},{"_id":"qgdd75hIlATVndZA","type":0,"text":"Streams River","img":"icons/svg/d20-grey.svg","weight":1,"range":[85,85],"drawn":false,"flags":{}},{"_id":"K1UgQJHvn50166cC","type":0,"text":"Streams Ruins","img":"icons/svg/d20-grey.svg","weight":1,"range":[86,86],"drawn":false,"flags":{}},{"_id":"VwPqzUfTgB3CSNwe","type":0,"text":"Streams Hill","img":"icons/svg/d20-grey.svg","weight":1,"range":[87,87],"drawn":false,"flags":{}},{"_id":"HmafNL8w67aTaEbB","type":0,"text":"Streams Forest","img":"icons/svg/d20-grey.svg","weight":1,"range":[88,88],"drawn":false,"flags":{}},{"_id":"FrjzCthkUligW6aF","type":0,"text":"Streams Lake","img":"icons/svg/d20-grey.svg","weight":1,"range":[89,89],"drawn":false,"flags":{}},{"_id":"bDcOdLhWgFn4Jn8w","type":0,"text":"Streams Outpost","img":"icons/svg/d20-grey.svg","weight":1,"range":[90,90],"drawn":false,"flags":{}},{"_id":"qLM5Q6uGcS2WHz2t","type":0,"text":"Streams Pass","img":"icons/svg/d20-grey.svg","weight":1,"range":[91,91],"drawn":false,"flags":{}},{"_id":"ZxZ8iewAzgVZoh1g","type":0,"text":"Streams Farm","img":"icons/svg/d20-grey.svg","weight":1,"range":[92,92],"drawn":false,"flags":{}},{"_id":"4v6xKQxig6JQ1eRF","type":0,"text":"Streams Trail","img":"icons/svg/d20-grey.svg","weight":1,"range":[93,93],"drawn":false,"flags":{}},{"_id":"QBdKr0SrqchQH7Pb","type":0,"text":"Streams Bridge","img":"icons/svg/d20-grey.svg","weight":1,"range":[94,94],"drawn":false,"flags":{}},{"_id":"VmYYh7l0aFwrGnK4","type":0,"text":"Streams Wall","img":"icons/svg/d20-grey.svg","weight":1,"range":[95,95],"drawn":false,"flags":{}},{"_id":"zg6jFVWYz4PFO5lT","type":0,"text":"Streams Dwelling","img":"icons/svg/d20-grey.svg","weight":1,"range":[96,96],"drawn":false,"flags":{}},{"_id":"a4wcVuS8cjmrFi8L","type":0,"text":"Thorns River","img":"icons/svg/d20-grey.svg","weight":1,"range":[97,97],"drawn":false,"flags":{}},{"_id":"A3WAkyp2vrBh5791","type":0,"text":"Thorns Ruins","img":"icons/svg/d20-grey.svg","weight":1,"range":[98,98],"drawn":false,"flags":{}},{"_id"