6e3Snl0hEhbel","type":0,"text":"Ravine Pass","img":"icons/svg/d20-grey.svg","weight":1,"range":[127,127],"drawn":false,"flags":{}},{"_id":"mOdtvTVaLZ0kBg92","type":0,"text":"Ravine Farm","img":"icons/svg/d20-grey.svg","weight":1,"range":[128,128],"drawn":false,"flags":{}},{"_id":"FUT2zVgao6ueyWVb","type":0,"text":"Ravine Trail","img":"icons/svg/d20-grey.svg","weight":1,"range":[129,129],"drawn":false,"flags":{}},{"_id":"425I5wjciqSoCa5U","type":0,"text":"Ravine Bridge","img":"icons/svg/d20-grey.svg","weight":1,"range":[130,130],"drawn":false,"flags":{}},{"_id":"ClXmDfI6mRnmewDQ","type":0,"text":"Ravine Wall","img":"icons/svg/d20-grey.svg","weight":1,"range":[131,131],"drawn":false,"flags":{}},{"_id":"H8XT8YKyPkboJpGl","type":0,"text":"Ravine Dwelling","img":"icons/svg/d20-grey.svg","weight":1,"range":[132,132],"drawn":false,"flags":{}},{"_id":"2LS0cCkYQrT1swxB","type":0,"text":"Tombs River","img":"icons/svg/d20-grey.svg","weight":1,"range":[133,133],"drawn":false,"flags":{}},{"_id":"zXRIVrFwKMt8XV9B","type":0,"text":"Tombs Ruins","img":"icons/svg/d20-grey.svg","weight":1,"range":[134,134],"drawn":false,"flags":{}},{"_id":"iUI3pBvlqUeTlrwW","type":0,"text":"Tombs Hill","img":"icons/svg/d20-grey.svg","weight":1,"range":[135,135],"drawn":false,"flags":{}},{"_id":"QhNzdleFOsMQ4XJu","type":0,"text":"Tombs Forest","img":"icons/svg/d20-grey.svg","weight":1,"range":[136,136],"drawn":false,"flags":{}},{"_id":"n4HFzyYRgABtnH0S","type":0,"text":"Tombs Lake","img":"icons/svg/d20-grey.svg","weight":1,"range":[137,137],"drawn":false,"flags":{}},{"_id":"FRnA7a2RfYJEhCKN","type":0,"text":"Tombs Outpost","img":"icons/svg/d20-grey.svg","weight":1,"range":[138,138],"drawn":false,"flags":{}},{"_id":"5z39CopZqX8h7F1T","type":0,"text":"Tombs Pass","img":"icons/svg/d20-grey.svg","weight":1,"range":[139,139],"drawn":false,"flags":{}},{"_id":"WGLSYo1H805Psgif","type":0,"text":"Tombs Farm","img":"icons/svg/d20-grey.svg","weight":1,"range":[140,140],"drawn":false,"flags":{}},{"_id":"hAWdUty58K8zaeku","type":0,"text":"Tombs Trail","img":"icons/svg/d20-grey.svg","weight":1,"range":[141,141],"drawn":false,"flags":{}},{"_id":"UitfEo6gR0wXu03q","type":0,"text":"Tombs Bridge","img":"icons/svg/d20-grey.svg","weight":1,"range":[142,142],"drawn":false,"flags":{}},{"_id":"tqE4KdepG2NFwBpa","type":0,"text":"Tombs Wall","img":"icons/svg/d20-grey.svg","weight":1,"range":[143,143],"drawn":false,"flags":{}},{"_id":"lERPr9Ps0KZBfVkT","type":0,"text":"Tombs Dwelling","img":"icons/svg/d20-grey.svg","weight":1,"range":[144,144],"drawn":false,"flags":{}}],"sort":0,"ownership":{"default":0},"flags":{}}
{"_id":"xCoP4FTgsv6PaMMq","name":"Between the Ages","formula":"1d66","replacement":true,"displayRoll":true,"description":"","img":"icons/svg/d20-grey.svg","results":[{"_id":"iIFhoZ1o6RlQVGbQ","type":0,"text":"You suffered a great failure and must re-pledge your Oath in order to retain your Knighthood.","img":"icons/svg/d20-grey.svg","weight":1,"range":[1,1],"drawn":false,"flags":{}},{"_id":"cAAPkdUxRI58nfRO","type":0,"text":"You have been in a nearby Realm on diplomatic duty. Roll a Spirit Save. On a pass, you are now well-esteemed there. On a fail you triggered a war with them.","img":"icons/svg/d20-grey.svg","weight":1,"range":[2,2],"drawn":false,"flags":{}},{"_id":"zaSgs7OwAW8xIH1v","type":0,"text":"You have become deathly ill. You that know you will die before the next Age without supernatural intervention.","img":"icons/svg/d20-grey.svg","weight":1,"range":[3,3],"drawn":false,"flags":{}},{"_id":"T3G4GAIVA3ITk6W9","type":0,"text":"You saved the life of a Seer, so they owe you a favour.","img":"icons/svg/d20-grey.svg","weight":1,"range":[4,4],"drawn":false,"flags":{}},{"_id":"oYjxgCXpWbt4Ohgi","type":0,"text":"You have been named as heir to a Seat of Power.","img":"icons/svg/d20-grey.svg","weight":1,"range":[5,5],"drawn":false,"flags":{}},{"_id":"I9gGTqcFPASBT4IQ","type":0,"text":"You gain an especially loyal pet.","img":"icons/svg/d20-grey.svg","weight":1,"range":[6,6],"drawn":false,"flags":{}},{"_id":"x29o48QotvIOv15G","type":0,"text":"The most important non-player character to you dies suddenly. You are with them in their last moments.","img":"icons/svg/d20-grey.svg","weight":1,"range":[7,7],"drawn":false,"flags":{}},{"_id":"ztps5GrKKkrWSLhQ","type":0,"text":"You have spent years trapped in an Otherworld.","img":"icons/svg/d20-grey.svg","weight":1,"range":[8,8],"drawn":false,"flags":{}},{"_id":"xPvXpwc10H35twWf","type":0,"text":"You brokered peace with raiders from beyond your borders, who have set up a Holding of their own in the Realm.","img":"icons/svg/d20-grey.svg","weight":1,"range":[9,9],"drawn":false,"flags":{}},{"_id":"17WnY4BlQKiUakWL","type":0,"text":"You won a great battle. Choose its location and roll a Vigour Save. On a pass you won, placing a Monument there. Otherwise you lost, placing a Curse there.","img":"icons/svg/d20-grey.svg","weight":1,"range":[10,10],"drawn":false,"flags":{}},{"_id":"1dmnZ0iThWBS3zpj","type":0,"text":"A distant or estranged relative has come to the Realm, finding a place in court.","img":"icons/svg/d20-grey.svg","weight":1,"range":[11,11],"drawn":false,"flags":{}},{"_id":"Qo6QSBLNOckLIwHR","type":0,"text":"An enemy or rival from your past has found a place in court.","img":"icons/svg/d20-grey.svg","weight":1,"range":[12,12],"drawn":false,"flags":{}},{"_id":"7i3SBXvaPE6m4COf","type":0,"text":"You inherit a piece of armour (your choice) belonging to a Knight-Radiant, who has left to find the city. Old knights hold you in high regard when you wear it.","img":"icons/svg/d20-grey.svg","weight":1,"range":[13,13],"drawn":false,"flags":{}},{"_id":"RMKYigUPv6sChILl","type":0,"text":"Roll a Clarity Save. On a pass you helped depose an unjust ruler, who seeks petty revenge against you. On a fail you unwittingly helped to make them a ruler.","img":"icons/svg/d20-grey.svg","weight":1,"range":[14,14],"drawn":false,"flags":{}},{"_id":"huQJswr4yWLgBX1t","type":0,"text":"A defeated foe has placed a sizeable bounty on your head.","img":"icons/svg/d20-grey.svg","weight":1,"range":[15,15],"drawn":false,"flags":{}},{"_id":"1S2XZdXGYRCIHA9Q","type":0,"text":"You received prophetic dreams of a new Myth in the realm. The dreams relate to its final Omen.","img":"icons/svg/d20-grey.svg","weight":1,"range":[16,16],"drawn":false,"flags":{}},{"_id":"uDKLrZB8iAP2IRLd","type":0,"text":"You helped a new Seer find their sanctuary. Place it anywhere you wish.","img":"icons/svg/d20-grey.svg","weight":1,"range":[17,17],"drawn":false,"flags":{}},{"_id":"33krqSG366W74XPL","type":0,"text":"A random visiting Knight gifts you their steed before they leave.","img":"icons/svg/d20-grey.svg","weight":1,"range":[18,18],"drawn":false,"flags":{}},{"_id":"izco7N4yIKi78GNR","type":0,"text":"Justifiable or not, the vassals have taken to calling you \"The Wicked\"","img":"icons/svg/d20-grey.svg","weight":1,"range":[19,19],"drawn":false,"flags":{}},{"_id":"msO0xQuRAQcsmT0D","type":0,"text":"Justifiable or not, the vassals have taken to calling you \"The Great\"","img":"icons/svg/d20-grey.svg","weight":1,"range":[20,20],"drawn":false,"flags":{}},{"_id":"ipFLDVcnSGmipvXz","type":0,"text":"You are offered a new Knightly title. Roll a new Knight type and decide if you wish to exchange your gear and ability for the new one.","img":"icons/svg/d20-grey.svg","weight":1,"range":[21,21],"drawn":false,"flags":{}},{"_id":"ZMgAi9hSSspmEIJ9","type":0,"text":"As a diplomatic gesture you have been barred from visiting the Seat of Power.","img":"icons/svg/d20-grey.svg","weight":1,"range":[22,22],"drawn":false,"flags":{}},{"_id":"n0veOyvEmHYphpSm","type":0,"text":"You fight in a battle that sees the destruction of a random holding. Decide which side you were on.","img":"icons/svg/d20-grey.svg","weight":1,"range":[23,23],"drawn":false,"flags":{}},{"_id":"dT1C3wuqp41HzMhl","type":0,"text":"You set up a modest home for yourself that has grown into a dwelling. Place it wherever you choose.","img":"icons/svg/d20-grey.svg","weight":1,"range":[24,24],"drawn":false,"flags":{}},{"_id":"WSqnDtlWLmYgdRjq","type":0,"text":"Illness plagues those close to you. Choose three non-player characters close to you. They must each pass a Vigour Save or die.","img":"icons/svg/d20-grey.svg","weight":1,"range":[25,25],"drawn":false,"flags":{}},{"_id":"po5BUbVnvsoPE1Bj","type":0,"text":"A ghost from a previous encounter still haunts you. You cannot sleep alone.","img":"icons/svg/d20-grey.svg","weight":1,"range":[26,26],"drawn":false,"flags":{}},{"_id":"MkoluuMa4D57mi6M","type":0,"text":"You have been exiled from the Realm. If you stay you are doing so under a false identity.","img":"icons/svg/d20-grey.svg","weight":1,"range":[27,27],"drawn":false,"flags":{}},{"_id":"Tvsyl83dV5sxND1W","type":0,"text":"You were sent to fight against a nearby Realm, earning a bloody reputation amongst its loyal Knights. They swore to come for you one day.","img":"icons/svg/d20-grey.svg","weight":1,"range":[28,28],"drawn":false,"flags":{}},{"_id":"y0TAOVYSypBZfLLA","type":0,"text":"You helped a young protegee become a full Knight. Roll their Knight type at random, and they are now roaming the Realm on their own quest.","img":"icons/svg/d20-grey.svg","weight":1,"range":[29,29],"drawn":false,"flags":{}},{"_id":"NviH56dD3R4ddbrt","type":0,"text":"Time has been cruel to you. If you are Mature, immediately age to Old. If you are Old, lose d6 Vigour to a minimum of 2.","img":"icons/svg/d20-grey.svg","weight":1,"range":[30,30],"drawn":false,"flags":{}},{"_id":"j3JfMyNCrYanfKyU","type":0,"text":"Time has been good to you. If you would age to Old, remain as Mature instead. If you would age to Mature you may increase any one Virtue by d6 to a maximum of 18.","img":"icons/svg/d20-grey.svg","weight":1,"range":[31,31],"drawn":false,"flags":{}},{"_id":"LzqBWoqnL7dCHXgN","type":0,"text":"You earn a reputation in tournaments. Gain d6 Maximum Guard to a maximum of 18.","img":"icons/svg/d20-grey.svg","weight":1,"range":[32,32],"drawn":false,"flags":{}},{"_id":"WsUuApu1BaOPYpTZ","type":0,"text":"You were embroiled in a blood feud with a ruler of the Realm. Decide somebody close to you who died in the conflict, and also somebody close to them.","img":"icons/svg/d20-grey.svg","weight":1,"range":[33,33],"drawn":false,"flags":{}},{"_id":"Jf5gyIgoCewYDonU","type":0,"text":"A particularly harrowing battle leaves you with little appetite for combat Lose d6 Maximum Guard to a minimum of 1.","img":"icons/svg/d20-grey.svg","weight":1,"range":[34,34],"drawn":false,"flags":{}},{"_id":"kjuYeoyTH78A1e9Q","type":0,"text":"Another Knight bearing your title has entered the Realm, seeking to usurp your position.","img":"icons/svg/d20-grey.svg","weight":1,"range":[35,35],"drawn":false,"flags":{}},{"_id":"DQeMgOttpM3GT2du","type":0,"text":"A holding unexpectedly fell into your rule.","img":"icons/svg/d20-grey.svg","weight":1,"range":[36,36],"drawn":false,"flags":{}}],"sort":0,"ownership":{"default":0},"flags":{}}
