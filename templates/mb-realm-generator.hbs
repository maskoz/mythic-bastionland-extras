<div class="mb-realm-generator">

  <div class="realm-header">
    <span class="realm-name">{{realmName}}</span>
    <button class="realm-gen-btn" data-action="generate-new" {{#if building}}disabled{{/if}}>
      <i class="fas fa-dice-d12"></i> New Realm
    </button>
  </div>

  <div class="realm-body">

    {{!-- Holdings --}}
    <section class="realm-section">
      <h3 class="realm-section-title"><i class="fas fa-chess-rook"></i> Holdings</h3>
      {{#each holdings}}
      <div class="holding-card {{#if seat}}holding-seat{{/if}}">
        <div class="holding-card-head">
          <strong>{{#if seat}}★ {{/if}}{{label}}. {{name}}</strong>
          <span class="holding-hex">[{{hex.col}},{{hex.row}}]</span>
        </div>
        <div class="holding-card-body">
          <div class="hc-row"><span class="hc-lbl">Ruler</span> {{rulerName}}{{#if rulerName}},&nbsp;{{/if}}{{ruler}}{{#if rulerPage}} <span class="pg-ref">p.{{rulerPage}}</span>{{/if}}</div>
          <div class="hc-row"><span class="hc-lbl">Terrain</span> {{terrainLabel}}</div>
          <div class="hc-row"><span class="hc-lbl">Exterior</span> {{exterior}}</div>
          <div class="hc-row"><span class="hc-lbl">Bailey</span> {{bailey}}</div>
          <div class="hc-row"><span class="hc-lbl">Keep</span> {{keep}}</div>
          <div class="hc-row"><span class="hc-lbl">Woe</span> {{woe}}</div>
          <div class="hc-row"><span class="hc-lbl">Drama</span> {{drama}}</div>
          <div class="hc-row"><span class="hc-lbl">Desire</span> {{desire}}</div>
          <div class="hc-row"><span class="hc-lbl">Appearance</span> {{appearance}}</div>
          <div class="hc-row"><span class="hc-lbl">Personality</span> {{personality}}</div>
          <div class="hc-row"><span class="hc-lbl">Quest</span> {{quest}}</div>
          {{#each rels}}
          <div class="hc-row hc-rel"><span class="hc-lbl">Re {{to}}</span> {{rel}} with {{name}}</div>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </section>

    {{!-- Myths --}}
    <section class="realm-section">
      <h3 class="realm-section-title"><i class="fas fa-dragon"></i> Active Myths</h3>
      {{#each myths}}
      <div class="myth-row">
        <span class="myth-num">{{number}}</span>
        <strong class="myth-name">{{name}}</strong>
        {{#if page}}<span class="pg-ref">p.{{page}}</span>{{/if}}
        <span class="myth-hex">[{{hex.col}},{{hex.row}}]</span>
      </div>
      {{/each}}
    </section>

    {{!-- Landmarks --}}
    <section class="realm-section">
      <h3 class="realm-section-title"><i class="fas fa-map-pin"></i> Landmarks</h3>
      <div class="landmarks-grid">
        {{#each landmarksList}}
        <div class="landmark-card">
          <span class="lm-icon">{{icon}}</span>
          <div class="lm-body">
            <div class="lm-type">{{label}}{{#if page}} <span class="pg-ref">p.{{page}}</span>{{/if}}</div>
            <div class="lm-desc">{{description}}</div>
            <div class="lm-hex">[{{hex.col}},{{hex.row}}]</div>
          </div>
        </div>
        {{/each}}
      </div>
    </section>

  </div>{{!-- .realm-body --}}

  <style>
/* ── Layout ── */
.mb-realm-generator-app .window-content { padding: 0; display: flex; flex-direction: column; overflow: hidden; height: 100%; }
.mb-realm-generator { display: flex; flex-direction: column; height: 100%; overflow: hidden; font-size: 13px; }
.realm-header { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: rgba(0,0,0,0.12); border-bottom: 1px solid rgba(0,0,0,0.25); flex-shrink: 0; }
.realm-name { font-size: 14px; font-weight: bold; flex: 1; color: var(--color-text-primary, #c8a030); letter-spacing: 1px; }
.realm-gen-btn { background: transparent; border: 1px solid rgba(255,255,255,0.2); padding: 4px 10px; cursor: pointer; border-radius: 3px; }
.realm-gen-btn:hover { background: rgba(255,255,255,0.1); }
.realm-body { flex: 1; overflow-y: auto; padding: 10px 12px; display: flex; flex-direction: column; gap: 14px; }
.realm-build-bar { display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-top: 1px solid rgba(0,0,0,0.25); background: rgba(0,0,0,0.08); flex-shrink: 0; }
.mb-scene-name { flex: 1; padding: 4px 7px; border-radius: 3px; border: 1px solid rgba(0,0,0,0.3); background: rgba(0,0,0,0.15); color: inherit; }
.mb-overwrite-label { display: flex; align-items: center; gap: 4px; white-space: nowrap; font-size: 12px; }
.realm-build-btn { background: #4a6741; border: 1px solid #2a4721; color: #d0edc0; padding: 5px 13px; cursor: pointer; border-radius: 3px; white-space: nowrap; }
.realm-build-btn:hover:not(:disabled) { background: #5a7751; }
.realm-journals-btn { background: #3a4a6a; border: 1px solid #1a2a4a; color: #c0d0f0; padding: 5px 13px; cursor: pointer; border-radius: 3px; white-space: nowrap; }
.realm-journals-btn:hover:not(:disabled) { background: #4a5a7a; }
.realm-build-btn:disabled, .realm-gen-btn:disabled, .realm-journals-btn:disabled { opacity: 0.5; cursor: default; }
.realm-section-title { font-size: 12px; letter-spacing: 2px; text-transform: uppercase; opacity: 0.7; margin: 0 0 6px; padding-bottom: 4px; border-bottom: 1px solid rgba(0,0,0,0.2); }
.holding-card { background: rgba(0,0,0,0.1); border: 1px solid rgba(0,0,0,0.2); border-radius: 4px; margin-bottom: 6px; overflow: hidden; }
.holding-card.holding-seat { border-color: rgba(200,160,48,0.5); }
.holding-card-head { display: flex; justify-content: space-between; align-items: baseline; padding: 5px 8px; background: rgba(0,0,0,0.12); font-size: 13px; }
.holding-card.holding-seat .holding-card-head { background: rgba(200,160,48,0.12); }
.holding-hex { font-size: 11px; opacity: 0.55; font-family: monospace; }
.holding-card-body { padding: 4px 8px 6px; display: flex; flex-direction: column; gap: 1px; }
.hc-row { font-size: 12px; line-height: 1.5; }
.hc-lbl { color: var(--color-text-secondary, #8a7a50); font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; margin-right: 4px; }
.hc-rel { font-style: italic; }
.myth-row { display: flex; align-items: baseline; gap: 6px; padding: 3px 0; font-size: 12px; }
.myth-num { background: rgba(0,0,0,0.2); width: 18px; height: 18px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 11px; flex-shrink: 0; }
.myth-name { font-weight: bold; flex: 1; }
.myth-hex { font-family: monospace; font-size: 11px; opacity: 0.55; }
.pg-ref { font-size: 11px; opacity: 0.6; font-style: italic; }
.landmarks-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5px; }
.landmark-card { display: flex; gap: 6px; padding: 5px 7px; background: rgba(0,0,0,0.1); border: 1px solid rgba(0,0,0,0.15); border-radius: 3px; }
.lm-icon { font-size: 16px; flex-shrink: 0; width: 20px; text-align: center; }
.lm-body { flex: 1; min-width: 0; }
.lm-type { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; opacity: 0.6; }
.lm-desc { font-size: 11px; line-height: 1.4; }
.lm-hex { font-family: monospace; font-size: 10px; opacity: 0.5; }
  </style>

  <div class="realm-build-bar">
    <input class="mb-scene-name" type="text" value="{{realmName}}" placeholder="Scene name" {{#if building}}disabled{{/if}}>
    <label class="mb-overwrite-label">
      <input class="mb-overwrite" type="checkbox" {{#if building}}disabled{{/if}}> Overwrite
    </label>
    <button class="realm-journals-btn" data-action="build-journals" {{#if building}}disabled{{/if}}>
      <i class="fas fa-book"></i> Journals
    </button>
    <button class="realm-build-btn" data-action="build-scene" {{#if building}}disabled{{/if}}>
      {{#if building}}
        <i class="fas fa-spinner fa-spin"></i> Building…
      {{else}}
        <i class="fas fa-map"></i> Build Scene
      {{/if}}
    </button>
  </div>

</div>
